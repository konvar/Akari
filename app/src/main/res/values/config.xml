<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher configuration. Edit this file, then run launcher/build-and-install.sh (or .ps1).
  Package names: on the TV run `pm list packages` (tools/tv.py 'pm list packages').
-->
<resources>

    <!-- Apps shown first in "Your apps", in this order. The other apps follow alphabetically. -->
    <string-array name="dock_apps">
        <item>com.nuvio.tv.updated</item>
        <item>io.gh.reisxd.tizentube.cobalt</item>
        <item>com.nuvio.tv</item>
        <item>org.smarttube.beta</item>
    </string-array>

    <!-- Apps never shown as tiles (e.g. the Live TV app, which the Inputs button already covers). -->
    <string-array name="hidden_apps">
        <item>com.tcl.tv</item>
    </string-array>

    <!-- Remote buttons that open an app from anywhere, as "keycode=package". Handled by InputKeyService,
         so it must be enabled (-InputKeyService). Find a button's keycode with `logcat | grep keyCode`. -->
    <string-array name="key_apps">
        <item>4062=com.nuvio.tv.updated</item>
        <item>190=io.gh.reisxd.tizentube.cobalt</item>
    </string-array>

    <!-- The app that opens movies and shows, through its nuvio://meta?type=…&id=… deep link. -->
    <string name="content_package" translatable="false">com.nuvio.tv.updated</string>

    <!-- Stremio catalog addon the home rows and search come from. Cinemeta is public and needs no account. -->
    <string name="addon_url" translatable="false">https://v3-cinemeta.strem.io</string>

    <!-- Home rows under "Your apps", as "Title|type|Trakt list|Cinemeta catalog". The Trakt list
         (trending, popular, anticipated, watched/weekly, boxoffice) is used first; the Cinemeta catalog
         from the addon's manifest is the fallback when Trakt does not answer. -->
    <string-array name="content_rows">
        <item>Airing tonight|tonight|tvmaze|</item>
        <item>Trending movies|movie|trending|top</item>
        <item>Trending shows|series|trending|top</item>
        <item>Popular movies|movie|popular|top</item>
        <item>Popular shows|series|popular|top</item>
        <item>Box office|movie|boxoffice|year</item>
        <item>Most watched this week|movie|watched/weekly|imdbRating</item>
        <item>Most watched shows this week|series|watched/weekly|imdbRating</item>
        <item>Most anticipated movies|movie|anticipated|year</item>
        <item>Most anticipated shows|series|anticipated|year</item>
        <item>Popular lists|lists|popular|</item>
    </string-array>

    <!-- Weather next to the clock (Open-Meteo, no key): place name, latitude, longitude, time zone. -->
    <string name="weather_place" translatable="false">Bucharest</string>
    <string name="weather_latitude" translatable="false">44.4268</string>
    <string name="weather_longitude" translatable="false">26.1025</string>
    <string name="weather_timezone" translatable="false">Europe/Bucharest</string>

    <!-- The TV's Live TV / tuner app, opened by the Inputs button when the system input list is missing. -->
    <string name="live_tv_package" translatable="false">com.tcl.tv</string>
</resources>
