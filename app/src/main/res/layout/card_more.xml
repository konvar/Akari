<?xml version="1.0" encoding="utf-8"?>
<!-- Last card of a Trakt row: opens the whole category, or all lists, as a grid. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="100dp"
    android:layout_height="150dp"
    android:layout_marginEnd="14dp"
    android:background="@drawable/glass_tile"
    android:foreground="@drawable/card_focus"
    android:focusable="true"
    android:clickable="true">

    <ImageView
        android:id="@+id/cardImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="→"
            android:textColor="#FFFFFFFF"
            android:textSize="30sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/show_more"
            android:textColor="#E6FFFFFF"
            android:textSize="13sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 500" />

        <TextView
            android:id="@+id/cardLabel"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
