<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pageRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- Backdrop on the right; the text column on the left stays on plain background so it reads well. -->
    <FrameLayout
        android:layout_width="580dp"
        android:layout_height="400dp"
        android:layout_gravity="top|end">

        <ImageView
            android:id="@+id/backdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no" />

        <View
            android:id="@+id/fadeLeft"
            android:layout_width="300dp"
            android:layout_height="match_parent" />

        <View
            android:id="@+id/fadeBottom"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_gravity="bottom" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="20dp">

        <LinearLayout
            android:layout_width="440dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/logo"
                android:layout_width="340dp"
                android:layout_height="84dp"
                android:scaleType="matrix"
                android:visibility="gone"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:gravity="bottom"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="#FFFFFFFF"
                android:textSize="30sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500" />

            <TextView
                android:id="@+id/meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="#D9FFFFFF"
                android:textSize="13sp"
                android:fontFamily="@font/outfit" />

            <LinearLayout
                android:id="@+id/ratings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tagline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:textStyle="italic"
                android:textColor="#B3FFFFFF"
                android:textSize="13sp"
                android:fontFamily="@font/outfit"
                android:visibility="gone" />

            <TextView
                android:id="@+id/description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxLines="4"
                android:lineSpacingMultiplier="1.15"
                android:textColor="#B3FFFFFF"
                android:textSize="12.5sp"
                android:fontFamily="@font/outfit" />

            <LinearLayout
                android:id="@+id/buttons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/play"
                    style="@style/TopButton"
                    android:layout_marginStart="0dp"
                    android:text="@string/play"
                    android:drawableStart="@drawable/ic_play" />

                <TextView
                    android:id="@+id/trailer"
                    style="@style/TopButton"
                    android:layout_marginStart="12dp"
                    android:text="Trailer"
                    android:gravity="center"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rows"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="18dp"
            android:paddingBottom="120dp"
            android:clipToPadding="false" />
    </LinearLayout>
</FrameLayout>
