<?xml version="1.0" encoding="utf-8"?>
<!-- A user-made Trakt list, as on Trakt's site: its first poster, the next four fanned out behind it, then its
     name and author. The posters are filled in by ListArt. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="212dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="18dp"
    android:orientation="vertical"
    android:focusable="true"
    android:clickable="true">

    <FrameLayout
        android:id="@+id/listStack"
        android:layout_width="212dp"
        android:layout_height="150dp"
        android:background="@drawable/glass_tile"
        android:foreground="@drawable/card_focus"
        android:duplicateParentState="true">

        <ImageView
            android:id="@+id/cardImage"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/listIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="☰"
            android:textColor="#66FFFFFF"
            android:textSize="28sp" />
    </FrameLayout>

    <TextView
        android:id="@+id/cardLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"
        android:fontFamily="@font/outfit"
        android:fontVariationSettings="'wght' 500" />

    <TextView
        android:id="@+id/cardSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="#99FFFFFF"
        android:textSize="11sp"
        android:fontFamily="@font/outfit" />
</LinearLayout>
