<?xml version="1.0" encoding="utf-8"?>
<!-- A text card on the details page: a parental guide category (name, and severity in its colour) or a Trakt
     comment (author line, then the text). Rows sets the width and height per kind. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="170dp"
    android:layout_height="74dp"
    android:layout_marginEnd="14dp"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:background="@drawable/glass_tile"
    android:foreground="@drawable/card_focus"
    android:focusable="true"
    android:clickable="true">

    <ImageView
        android:id="@+id/cardImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/cardLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"
        android:fontFamily="@font/outfit"
        app:weight="500" />

    <TextView
        android:id="@+id/cardSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="5"
        android:lineSpacingExtra="2dp"
        android:textColor="#B3FFFFFF"
        android:textSize="12sp"
        android:fontFamily="@font/outfit" />
</LinearLayout>
