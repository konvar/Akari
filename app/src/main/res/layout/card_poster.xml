<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="100dp"
    android:layout_height="150dp"
    android:layout_marginEnd="14dp"
    android:background="@drawable/card_bg"
    android:foreground="@drawable/card_focus"
    android:focusable="true"
    android:clickable="true">

    <TextView
        android:id="@+id/cardLabel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="8dp"
        android:textColor="#B3FFFFFF"
        android:textSize="12sp"
        android:fontFamily="@font/outfit" />

    <com.konvar.tvhome.CardImage
        android:id="@+id/cardImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/card_bg"
        android:backgroundTint="#00000000"
        android:scaleType="centerCrop" />
    <ImageView
        android:id="@+id/cardCheck"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="top|start"
        android:layout_margin="6dp"
        android:padding="3dp"
        android:background="@drawable/check_bg"
        android:src="@drawable/ic_check"
        android:visibility="gone"
        android:importantForAccessibility="no" />
    <com.konvar.tvhome.ImdbBadge
        android:id="@+id/cardImdbBadge"
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_gravity="top|end"
        android:layout_margin="5dp"
        android:background="@drawable/imdb_badge_bg"
        android:drawablePadding="3dp"
        android:fontFamily="@font/outfit"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:paddingStart="4dp"
        android:paddingEnd="5dp"
        android:singleLine="true"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:visibility="gone" />
</FrameLayout>
